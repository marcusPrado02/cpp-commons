{
  "name": "cpp-commons",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "onCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y ninja-build clang-17 clang-tidy-17 clang-format-17 lcov",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "xaver.clang-format"
      ],
      "settings": {
        "cmake.configurePreset": "dev",
        "cmake.buildPreset": "dev",
        "editor.formatOnSave": true,
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools"
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/ccache,target=/root/.ccache,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "CCACHE_DIR": "/root/.ccache"
  }
}
