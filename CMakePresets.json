{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "displayName": "Development (Debug + ASan + clang-tidy)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":                    "Debug",
        "CPP_COMMONS_BUILD_TESTS":             "ON",
        "CPP_COMMONS_BUILD_EXAMPLES":          "ON",
        "CPP_COMMONS_ENABLE_SANITIZERS":       "address",
        "CPP_COMMONS_ENABLE_CLANG_TIDY":       "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER":         "ccache"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Release + UBSan + tests)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":                "Release",
        "CPP_COMMONS_BUILD_TESTS":         "ON",
        "CPP_COMMONS_ENABLE_SANITIZERS":   "undefined",
        "CMAKE_EXPORT_COMPILE_COMMANDS":   "ON"
      }
    },
    {
      "name": "ci-asan",
      "displayName": "CI ASan (Debug + Address + tests)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/ci-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":              "Debug",
        "CPP_COMMONS_BUILD_TESTS":       "ON",
        "CPP_COMMONS_ENABLE_SANITIZERS": "address"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug + gcov)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":        "Debug",
        "CPP_COMMONS_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS":         "--coverage -fprofile-abs-path",
        "CMAKE_EXE_LINKER_FLAGS":  "--coverage"
      }
    },
    {
      "name": "release",
      "displayName": "Release (optimized)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":           "Release",
        "CPP_COMMONS_BUILD_TESTS":    "OFF",
        "CPP_COMMONS_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Benchmark (Release + perf)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/benchmark",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":             "Release",
        "CPP_COMMONS_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",       "configurePreset": "dev"       },
    { "name": "ci",        "configurePreset": "ci"        },
    { "name": "ci-asan",   "configurePreset": "ci-asan"   },
    { "name": "coverage",  "configurePreset": "coverage"  },
    { "name": "release",   "configurePreset": "release"   },
    { "name": "benchmark", "configurePreset": "benchmark" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci-asan",
      "configurePreset": "ci-asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
